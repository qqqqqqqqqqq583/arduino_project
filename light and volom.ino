//نام گزاری پایه ها
int v1 = A0;
int l1 = 9;
void setup() {
  //-------------تعریف چراغ ها-------------
  pinMode(l1, OUTPUT); // معرفی اولیه LED1
}

void loop() {
  //--------------کنترل پتانسیومتر--------------------
  int potValue1 = analogRead(v1);  //تعریف پتانسیومتر 1

  int aa1 = map(potValue1, 0, 1023, 0, 255); //تبدیل بازه 0 تا 1023 به 0 تا 255 برای پتانسیومتر 1

  analogWrite(l1, aa1); // تبادل اطلاعات بین پتانسیومتر1 و لامپ1

  delay(10);  // 1 ثانیه مکث کردن

}
